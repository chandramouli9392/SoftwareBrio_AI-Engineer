# =====================================================================
# SoftwareBrio Autonomous Lead Enrichment Agent Environment Variables
# =====================================================================

# LLM Provider Configuration
# Supported providers: openai, anthropic, gemini, groq, mistral, ollama, mock
DAVE_LLM_PROVIDER=openai
DAVE_LLM_MODEL=gpt-4o-mini

# Provider API Keys (Set the key for your selected provider)
DAVE_LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional LLM Base URL override (e.g. for self-hosted / vLLM / Ollama)
# DAVE_LLM_BASE_URL=http://localhost:11434

# Fetcher configuration (auto, http, playwright, stealth)
# DAVE_FETCHER=auto

# Cache & Rate Limiting
# DAVE_CACHE_DIR=~/.cache/dave
# DAVE_RATE_LIMIT=30

# Optional Web Search Provider for fallback discovery (duckduckgo, mock)
# DAVE_SEARCH_PROVIDER=duckduckgo
